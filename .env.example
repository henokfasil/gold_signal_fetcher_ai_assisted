# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
PAPER_TRADING=true
PAPER_ACCOUNT_SIZE=10000
GOLD_MIN_SCORE=45
GOLD_ATR_SL_MULTIPLIER=1.5
GOLD_ATR_TP_MULTIPLIER=3.0

# ── Claude models ─────────────────────────────────────────────────────────────
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-5

# ── Price data ────────────────────────────────────────────────────────────────
PRICE_DATA_PROVIDER=dukascopy
DUKASCOPY_SNAPSHOT_PATH=/tmp/dukascopy_snapshot.json
GOLD_CONTEXT_SNAPSHOT_PATH=/tmp/gold_context_snapshot.json
CONTEXT_SNAPSHOT_MAX_AGE_SECONDS=7200
# Legacy interactive research source; automated multi-timeframe use is disabled
# unless its independent cadence checks pass.
TRADINGVIEW_SNAPSHOT_PATH=/tmp/tradingview_snapshot.json

# Optional legacy provider (required only when PRICE_DATA_PROVIDER=metaapi)
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Optional point-in-time snapshot producers
MACRO_SNAPSHOT_PATH=/tmp/gold_macro_snapshot.json
EVENT_CONCORDANCE_REFERENCE_STAGING_PATH=/tmp/event_concordance_reference_snapshot.json
SNAPSHOT_MAX_AGE_SECONDS=900
DASHBOARD_FEED_MAX_AGE_SECONDS=1200
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8510
PRICE_BAR_MAX_LAG_SECONDS=1800

# Optional data locations
PAPER_TRADES_CSV=data/paper_trades_ai.csv
FORWARD_FEATURES_CSV=data/forward_candidate_features_v2.csv
FORWARD_OUTCOMES_CSV=data/forward_candidate_outcomes.csv
FORWARD_VARIANT_ASSIGNMENTS_CSV=data/forward_variant_assignments.csv
FORWARD_CONTEXT_CSV=data/forward_candidate_context_v1.csv
FORWARD_EVENT_OBSERVATIONS_CSV=data/forward_event_observations_v1.csv
FORWARD_EVENT_SCANS_CSV=data/forward_event_scans_v1.csv
FORWARD_AI_REVIEWS_CSV=data/forward_ai_reviews_v2.csv
RESEARCH_VARIANT_CONFIG=config/research_variants.json
FORWARD_CONTEXT_CONFIG=config/forward_context_observation_v1.json
FORWARD_EVENT_CONFIG=config/forward_event_observation_v1.json
EVENT_FEATURE_CONCORDANCE_CONFIG=config/event_feature_concordance_v1.json
EVENT_FEATURE_CONCORDANCE_STATUS_PATH=data/event_feature_concordance_status.json
EVIDENCE_INTEGRITY_CONFIG=config/evidence_integrity_v2.json
EVIDENCE_INTEGRITY_STATUS_PATH=data/evidence_integrity_status.json
RESEARCH_SPREAD_POINTS=0.35
RESEARCH_SLIPPAGE_POINTS=0.10
